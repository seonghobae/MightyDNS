# MightyDNS Environment Configuration
# Copy this file to .env and update with your values

# Environment
ENVIRONMENT=development

# Server
MIGHTYDNS__SERVER__HOST=0.0.0.0
MIGHTYDNS__SERVER__PORT=8080
MIGHTYDNS__SERVER__WORKERS=4

# Database
MIGHTYDNS__DATABASE__URL=postgresql://mightydns_user:change-me-in-production@localhost:5432/mightydns
MIGHTYDNS__DATABASE__MAX_CONNECTIONS=100
MIGHTYDNS__DATABASE__MIN_CONNECTIONS=10
MIGHTYDNS__DATABASE__CONNECT_TIMEOUT_SECS=10
MIGHTYDNS__DATABASE__IDLE_TIMEOUT_SECS=600

# Redis
MIGHTYDNS__REDIS__URL=redis://:redis_password@localhost:6379
MIGHTYDNS__REDIS__POOL_SIZE=100
MIGHTYDNS__REDIS__TIMEOUT_MS=1000

# NATS
MIGHTYDNS__NATS__URL=nats://localhost:4222
MIGHTYDNS__NATS__MAX_RECONNECTS=10

# DNS
MIGHTYDNS__DNS__UPSTREAM_SERVERS=1.1.1.1:53,8.8.8.8:53,9.9.9.9:53
MIGHTYDNS__DNS__TIMEOUT_MS=5000
MIGHTYDNS__DNS__CACHE_TTL_SECS=300
MIGHTYDNS__DNS__DOH_PORT=8443
MIGHTYDNS__DNS__DOT_PORT=853
MIGHTYDNS__DNS__UDP_PORT=53

# Authentication
MIGHTYDNS__AUTH__JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
MIGHTYDNS__AUTH__JWT_EXPIRY_HOURS=1
MIGHTYDNS__AUTH__OTP_EXPIRY_MINUTES=10
MIGHTYDNS__AUTH__WEBAUTHN_RP_ID=mightydns.com
MIGHTYDNS__AUTH__WEBAUTHN_RP_NAME=MightyDNS
MIGHTYDNS__AUTH__WEBAUTHN_ORIGIN=https://mightydns.com

# Logging
RUST_LOG=info,dns_server=debug,api_service=debug,common=debug
RUST_BACKTRACE=1

# TLS Certificates (for DoT and DoH)
TLS_CERT_PATH=./certs/fullchain.pem
TLS_KEY_PATH=./certs/privkey.pem

# Lemon Squeezy (Payment Gateway)
LEMON_SQUEEZY_API_KEY=your-lemon-squeezy-api-key
LEMON_SQUEEZY_STORE_ID=your-store-id
LEMON_SQUEEZY_WEBHOOK_SECRET=your-webhook-secret

# Email (AWS SES or Resend)
EMAIL_PROVIDER=resend
EMAIL_API_KEY=your-email-api-key
EMAIL_FROM_ADDRESS=noreply@mightydns.com
EMAIL_FROM_NAME=MightyDNS

# Monitoring
PROMETHEUS_ENABLED=true
JAEGER_ENDPOINT=http://localhost:14268/api/traces
